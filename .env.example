# Copy to .env (Docker/Node) or .dev.vars (wrangler dev). All optional; see README.md.

# --- Routing ---
# Instance served at /mcp (otherwise use /{instance_domain}/mcp).
#DEFAULT_INSTANCE=mastodon.social
# Comma-separated allowlist. Empty = any public instance.
#ALLOWED_INSTANCES=
# Public URL of this server; required behind proxies for correct OAuth redirects.
#PUBLIC_URL=https://mcp.example.com
# Trust X-Forwarded-Proto/Host when PUBLIC_URL is unset.
#TRUST_PROXY=false

# --- Auth ---
# Enables the OAuth facade (MCP clients log in via browser). Generate: openssl rand -base64 32
SECRET_KEY=
# required: no credential -> 401 (triggers OAuth in MCP clients). optional: anonymous public access.
#AUTH_MODE=required
# Accept raw Mastodon tokens in Authorization: Bearer / X-Mastodon-Token.
#ALLOW_PASSTHROUGH=true
#DEFAULT_SCOPES=read write follow push profile
#APP_SCOPES=read write follow push profile admin:read admin:write
#TOKEN_TTL_SECONDS=2592000
# Answer HTTP 403 insufficient_scope (MCP step-up auth) instead of a tool error.
#SCOPE_STEP_UP=false

# Static API keys for this server, mapped to server-side Mastodon tokens:
#MCP_API_KEYS=key1,key2
#MASTODON_TOKEN=            # token for DEFAULT_INSTANCE
#MASTODON_TOKENS={"mastodon.social":"..."}
# Pre-registered Mastodon apps (redirect URI must be {PUBLIC_URL}/oauth/callback):
#MASTODON_APPS={"mastodon.social":{"client_id":"...","client_secret":"..."}}

# --- Safety / limits ---
#READ_ONLY=false
#DISABLE_ADMIN=false
#ALLOWED_ORIGINS=
#MAX_OUTPUT_CHARS=40000
#UPSTREAM_TIMEOUT_MS=30000
#MAX_UPLOAD_BYTES=104857600

# --- Local development only ---
#HTTP_INSTANCES=localhost:3000
#ALLOW_PRIVATE_INSTANCES=false

# --- Node/Docker only ---
#HOST=127.0.0.1
#PORT=8787
#DATA_DIR=./data
